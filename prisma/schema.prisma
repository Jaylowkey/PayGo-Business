generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  phone         String?
  accountType   AccountType @default(INDIVIDUAL)
  kycStatus     VerificationStatus @default(NOT_STARTED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  organizations OrganizationMember[]
  wallets       Wallet[]
  payments      Payment[]
  payouts       Payout[]
}

model Organization {
  id            String   @id @default(cuid())
  legalName     String
  tradingName   String?
  nuit          String?  @unique
  kybStatus     VerificationStatus @default(NOT_STARTED)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  members       OrganizationMember[]
  wallets       Wallet[]
  payments      Payment[]
  payouts       Payout[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           BusinessRole @default(VIEWER)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Wallet {
  id             String       @id @default(cuid())
  userId         String?
  organizationId String?
  currency       Currency     @default(MZN)
  status         WalletStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        LedgerEntry[]
  payments       Payment[]
  payouts        Payout[]

  @@index([userId, currency])
  @@index([organizationId, currency])
}

model LedgerTransaction {
  id          String        @id @default(cuid())
  reference   String        @unique
  description String?
  metadata    Json?
  createdAt   DateTime      @default(now())
  entries     LedgerEntry[]
}

model LedgerEntry {
  id            String           @id @default(cuid())
  transactionId String
  walletId      String
  amountMinor   BigInt
  direction     LedgerDirection
  currency      Currency
  reference     String
  createdAt     DateTime         @default(now())
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, currency, createdAt])
  @@index([reference])
}

model Payment {
  id                 String        @id @default(cuid())
  reference          String        @unique
  provider           String
  providerPaymentId  String?
  userId             String?
  organizationId     String?
  walletId           String?
  amountMinor        BigInt
  feeMinor           BigInt        @default(0)
  currency           Currency
  status             PaymentStatus @default(PENDING)
  idempotencyKey     String        @unique
  description        String?
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization       Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  wallet             Wallet?      @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([provider, providerPaymentId])
}

model Payout {
  id                String        @id @default(cuid())
  reference         String        @unique
  provider          String
  providerPayoutId  String?
  userId            String?
  organizationId    String?
  walletId          String
  amountMinor       BigInt
  feeMinor          BigInt        @default(0)
  currency          Currency
  status            PayoutStatus  @default(PENDING)
  destination       Json
  idempotencyKey    String        @unique
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  wallet            Wallet        @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventKey    String   @unique
  eventType   String
  payload     Json
  status      WebhookEventStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  updatedAt   DateTime @updatedAt

  @@index([provider, eventType, receivedAt])
  @@index([status, receivedAt])
}

enum AccountType { INDIVIDUAL BUSINESS }
enum VerificationStatus { NOT_STARTED IN_REVIEW ACTION_REQUIRED VERIFIED REJECTED EXPIRED }
enum BusinessRole { OWNER ADMIN FINANCE DEVELOPER SUPPORT VIEWER }
enum Currency { MZN USD EUR ZAR }
enum WalletStatus { ACTIVE SUSPENDED CLOSED }
enum LedgerDirection { DEBIT CREDIT }
enum PaymentStatus { PENDING PROCESSING SUCCESS FAILED CANCELLED EXPIRED REFUNDED }
enum PayoutStatus { PENDING PROCESSING SUCCESS FAILED CANCELLED }
enum WebhookEventStatus { RECEIVED PROCESSING PROCESSED FAILED }
